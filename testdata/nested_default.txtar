Nested value references with defaults.

-- values.yaml --
config:
  name: my-app
-- input.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Values.config.name | default "fallback" }}
-- helm_output.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: my-app
-- output.cue --
import "struct"

#values: {
	config?: {
		name?: bool | number | string | null
		...
	}
	...
}

output: [
	{
		apiVersion: "v1"
		kind:       "ConfigMap"
		metadata: name: [if (_nonzero & {#arg: #values.config.name}).out {
			#values.config.name
		}, "fallback"][0]
	},
]
_nonzero: {
	#arg?: _
	out: [if #arg != _|_ {
		[
			if (#arg & int) != _|_ {#arg != 0},
			if (#arg & string) != _|_ {#arg != ""},
			if (#arg & float) != _|_ {#arg != 0.0},
			if (#arg & bool) != _|_ {#arg},
			if (#arg & [...]) != _|_ {len(#arg) > 0},
			if (#arg & {...}) != _|_ {(#arg & struct.MaxFields(0)) == _|_},
			false,
		][0]
	}, false][0]
}
-- experiments_output.cue --
@experiment(try,predicates)

import "struct"

#values: {
	config?: {
		name?: bool | number | string | null
		...
	}
	...
}

output: [
	{
		apiVersion: "v1"
		kind:       "ConfigMap"
		metadata: {
			try _x = #values.config.name? if (_nonzero & {#arg: _x}).out {
				name: _x
			} otherwise {
				name: "fallback"
			}
		}
	},
]
_nonzero: {
	#arg?: _
	out: [if isValid(#arg) {
		[
			if isValid(#arg & int) {#arg != 0},
			if isValid(#arg & string) {#arg != ""},
			if isValid(#arg & float) {#arg != 0.0},
			if isValid(#arg & bool) {#arg},
			if isValid(#arg & [...]) {len(#arg) > 0},
			if isValid(#arg & {...}) {!isValid(#arg & struct.MaxFields(0))},
			false,
		][0]
	}, false][0]
}
