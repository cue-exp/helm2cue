kindIs with bare dot inside with block.

-- values.yaml --
config: hello
-- input.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: test
data:
  {{- with .Values.config }}
  {{- if kindIs "string" . }}
  type: string
  {{- end }}
  {{- end }}
-- helm_output.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: test
data:
  type: string
-- output.cue --
import "struct"

#values: {
	config?: bool | number | string | null
	...
}

output: [
	{
		apiVersion: "v1"
		kind:       "ConfigMap"
		metadata: name: "test"
		data: {
			if (_nonzero & {#arg: #values.config}).out {
				if (#values.config & string) != _|_ {
					type: "string"
				}
			}
		}
	},
]
_nonzero: {
	#arg?: _
	out: [if #arg != _|_ {
		[
			if (#arg & int) != _|_ {#arg != 0},
			if (#arg & string) != _|_ {#arg != ""},
			if (#arg & float) != _|_ {#arg != 0.0},
			if (#arg & bool) != _|_ {#arg},
			if (#arg & [...]) != _|_ {len(#arg) > 0},
			if (#arg & {...}) != _|_ {(#arg & struct.MaxFields(0)) == _|_},
			false,
		][0]
	}, false][0]
}
-- experiments_output.cue --
@experiment(try,predicates)

import "struct"

#values: {
	config?: bool | number | string | null
	...
}

output: [
	{
		apiVersion: "v1"
		kind:       "ConfigMap"
		metadata: name: "test"
		data: {
			if (_nonzero & {#arg: #values.config}).out {
				if isValid(#values.config) && isValid(#values.config & string) {
					type: "string"
				}
			}
		}
	},
]
_nonzero: {
	#arg?: _
	out: [if isValid(#arg) {
		[
			if isValid(#arg & int) {#arg != 0},
			if isValid(#arg & string) {#arg != ""},
			if isValid(#arg & float) {#arg != 0.0},
			if isValid(#arg & bool) {#arg},
			if isValid(#arg & [...]) {len(#arg) > 0},
			if isValid(#arg & {...}) {!isValid(#arg & struct.MaxFields(0))},
			false,
		][0]
	}, false][0]
}
